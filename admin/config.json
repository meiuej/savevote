{
  "locale": "ru",
  "backend": {
    "name": "github",
    "repo": "meiuej/savevote",
    "branch": "main"
  },
  "publish_mode": "editorial_workflow",
  "site_url": "https://vote.chenterce.info",
  "media_folder": "uploads/news",
  "public_folder": "/uploads/news",
  "slug": {
    "encoding": "unicode",
    "clean_accents": false
  },
  "collections": [
    {
      "name": "news",
      "label": "Новости",
      "label_singular": "Новость",
      "folder": "content/news",
      "create": true,
      "format": "json",
      "extension": "json",
      "slug": "{{year}}-{{month}}-{{day}}-{{slug}}",
      "preview_path": "news/{{slug}}/",
      "summary": "{{title}} — {{date}}",
      "fields": [
        {
          "label": "Заголовок",
          "name": "title",
          "widget": "string"
        },
        {
          "label": "Дата публикации",
          "name": "date",
          "widget": "datetime",
          "format": "YYYY-MM-DDTHH:mm:ssZ"
        },
        {
          "label": "Краткое описание",
          "name": "summary",
          "widget": "text"
        },
        {
          "label": "Обложка",
          "name": "image",
          "widget": "image",
          "required": false
        },
        {
          "label": "Описание изображения",
          "name": "image_alt",
          "widget": "string",
          "required": false
        },
        {
          "label": "Текст новости",
          "name": "body",
          "widget": "text",
          "hint": "Разделяйте абзацы пустой строкой."
        }
      ]
    }
  ]
}
